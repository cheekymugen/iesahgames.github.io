<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IES AH Unblocked Games</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #050505;
            color: #00ff33;
            font-family: 'Fira Code', monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Efecto de líneas de monitor antiguo (retro hacker) */
        body::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 2;
            background-size: 100% 2px, 3px 100%;
            pointer-events: none;
        }

        .login-container {
            background-color: rgba(10, 10, 10, 0.9);
            border: 2px solid #00ff33;
            box-shadow: 0 0 20px rgba(0, 255, 51, 0.2);
            padding: 40px;
            border-radius: 5px;
            text-align: center;
            max-width: 530px;
            width: 90%;
            z-index: 3;
        }

        h1 {
            font-size: 2.2rem;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(0, 255, 51, 0.5);
        }

        .description-top {
            color: #88ff99;
            font-size: 1.1rem;
            margin-bottom: 30px;
        }

        .google-btn-wrapper {
            display: flex;
            justify-content: center;
            margin-bottom: 35px;
        }

        .description-bottom {
            color: #a0a0a0;
            font-size: 0.95rem;
            line-height: 1.8;
            border-top: 1px dashed #00ff33;
            padding-top: 25px;
        }

        .contact-group {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 10px;
        }

        .contact-method {
            display: inline-flex;
            align-items: center;
            color: #00ff33;
            text-decoration: none;
            background: rgba(0, 255, 51, 0.05);
            padding: 6px 12px;
            border: 1px solid rgba(0, 255, 51, 0.3);
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .contact-method:hover {
            color: #ffffff;
            background: rgba(0, 255, 51, 0.15);
            box-shadow: 0 0 10px rgba(0, 255, 51, 0.3);
            border-color: #00ff33;
        }

        /* Estilo para las imágenes de los logos */
        .logo-img {
            width: 20px;
            height: 20px;
            margin-right: 8px;
            object-fit: contain;
            border-radius: 3px; /* Suaviza los bordes del cuadro blanco de Discord */
        }

        #status-msg {
            margin-top: 20px;
            padding: 10px;
            display: none;
            font-weight: bold;
        }
        .error { color: #ff3333; border: 1px solid #ff3333; }
        .success { color: #33ff33; border: 1px solid #33ff33; }
    </style>
</head>
<body>

    <div class="login-container">
        <h1>IES AH Unblocked Games</h1>
        
        <p class="description-top">> Inicia sesión con google para acceder</p>

        <div class="google-btn-wrapper">
            <div id="g_id_onload"
                 data-client_id="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
                 data-context="signin"
                 data-ux_mode="popup"
                 data-callback="handleCredentialResponse"
                 data-auto_prompt="false">
            </div>

            <div class="g_id_signin"
                 data-type="standard"
                 data-shape="rectangular"
                 data-theme="dark"
                 data-text="signin_with"
                 data-size="large"
                 data-logo_alignment="left">
            </div>
        </div>

        <div id="status-msg"></div>

        <div class="description-bottom">
            Para conseguir acceso, contáctame en:
            <div class="contact-group">
                <a href="https://wa.me/34722573462" target="_blank" class="contact-method">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" alt="WhatsApp" class="logo-img"> 
                    +34 722 573 462
                </a> 
                <div class="contact-method">
                    <img src="https://static.vecteezy.com/system/resources/thumbnails/006/892/625/small/discord-logo-icon-editorial-free-vector.jpg" alt="Discord" class="logo-img"> 
                    mugen_cheeky
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- SISTEMA DE LISTAS (Editable por ti) ---
        const STRICT_WHITELIST_MODE = true; 
        
        const whitelist = [
            "tu-email@gmail.com",
            "amigo@gmail.com"
        ];

        const blacklist = [
            "troll@gmail.com"
        ];
        // --------------------------------------------

        function parseJwt(token) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));

            return JSON.parse(jsonPayload);
        }

        function handleCredentialResponse(response) {
            const responsePayload = parseJwt(response.credential);
            const userEmail = responsePayload.email;
            
            const statusBox = document.getElementById("status-msg");
            statusBox.style.display = "block";

            if (blacklist.includes(userEmail)) {
                statusBox.className = "error";
                statusBox.innerText = `ACCESO DENEGADO: Tu correo (${userEmail}) está baneado.`;
                return;
            }

            if (STRICT_WHITELIST_MODE) {
                if (whitelist.includes(userEmail)) {
                    statusBox.className = "success";
                    statusBox.innerText = `ACCESO CONCEDIDO. ¡Hola ${responsePayload.given_name}! Abriendo juegos...`;
                    // window.location.href = "/tus-juegos.html";
                } else {
                    statusBox.className = "error";
                    statusBox.innerText = `ACCESO DENEGADO: El correo ${userEmail} no está en la lista blanca.`;
                }
            } else {
                statusBox.className = "success";
                statusBox.innerText = `ACCESO CONCEDIDO. Cargando...`;
            }
        }
    </script>
</body>
</html>
